generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String                @id @default(cuid())
  clerkId             String                @unique
  fullName            String
  firstName           String?
  lastName            String?
  email               String?               @unique
  phoneNumber         String?               @unique
  birthDate           DateTime?
  newsletterEnabled   Boolean               @default(false)
  role                UserRole              @default(MEMBER)
  avatarUrl           String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  nickname               String?
  isVerified             Boolean               @default(false)
  verifiedAt             DateTime?
  organizerTosAcceptedAt DateTime?
  organizerPhone         String?
  organizerLogoUrl       String?
  organizerBannerUrl     String?
  organizerBio           String?
  organizerAddress       String?
  twitterUsername        String?
  instagramUsername      String?
  facebookUrl            String?
  tiktokUsername         String?
  adBoosts            AdBoost[]
  events              Event[]               @relation("OrganizerEvents")
  jobListings         JobListing[]
  listings            Listing[]
  sentInvitations     ModeratorInvitation[] @relation("InvitedBy")
  tickets             Ticket[]
  umkm                Umkm[]
  umkmReviews         UmkmReview[]
  verificationRequest VerificationRequest?
  legalDoc            OrganizerLegalDoc?
  bankAccount         OrganizerBankAccount?
  transfersSent       TicketTransfer[]      @relation("TransfersSent")
  transfersReceived   TicketTransfer[]      @relation("TransfersReceived")
  ordersBought        MarketplaceOrder[]    @relation("OrdersBought")
  ordersSold          MarketplaceOrder[]    @relation("OrdersSold")
  checkoutSessions    CheckoutSession[]
  convAsBuyer         Conversation[]        @relation("ConvBuyer")
  convAsSeller        Conversation[]        @relation("ConvSeller")
  messagesSent        Message[]
  productFavorites    ProductFavorite[]
  shippingAddresses   ShippingAddress[]
  sellerBalance       SellerBalance?
  withdrawals         SellerWithdrawal[]

  @@map("users")
}

model ShippingAddress {
  id          String   @id @default(cuid())
  userId      String
  label       String   // "Rumah", "Kantor", dll
  recipient   String   // Nama penerima
  phone       String   // No. HP penerima
  address     String   // Alamat lengkap
  district    String?  // Kecamatan
  city        String?  // Kota/Kabupaten
  province    String?  // Provinsi
  postalCode  String?  // Kode pos
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])

  @@map("shipping_addresses")
}

model OrganizerLegalDoc {
  id           String    @id @default(cuid())
  userId       String    @unique
  docType      String    @default("INDIVIDU")
  ktpNumber    String?
  ktpName      String?
  ktpAddress   String?
  ktpImageUrl  String?
  npwpNumber   String?
  npwpName     String?
  npwpAddress  String?
  npwpImageUrl String?
  adNumber     String?
  adName       String?
  adAddress    String?
  adImageUrl   String?
  nibNumber    String?
  status       String    @default("BELUM")
  adminNotes   String?
  submittedAt  DateTime?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id])

  @@map("organizer_legal_docs")
}

model OrganizerBankAccount {
  id            String   @id @default(cuid())
  userId        String   @unique
  bankName      String
  bankCode      String
  accountNumber String
  accountName   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id])

  @@map("organizer_bank_accounts")
}

model News {
  id          String      @id @default(cuid())
  title       String
  snippet     String
  imageUrl    String?
  sourceUrl   String      @unique
  sourceName  String
  publishedAt DateTime
  crawledAt   DateTime    @default(now())
  isActive    Boolean     @default(true)
  sourceId    String?
  newsSource  NewsSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([publishedAt(sort: Desc)])
  @@map("news")
}

model NewsSource {
  id            String    @id @default(cuid())
  name          String
  siteUrl       String
  rssUrl        String?
  keywords      String[]
  isActive      Boolean   @default(true)
  lastCrawledAt DateTime?
  articleCount  Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  news          News[]

  @@map("news_sources")
}

model Listing {
  id           String        @id @default(cuid())
  sellerId     String
  title        String
  description  String
  price        Int
  category     String
  images       String[]
  location     String?
  status       ListingStatus @default(ACTIVE)
  isPremium    Boolean       @default(false)
  premiumUntil DateTime?
  viewCount    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  boosts       AdBoost[]
  seller       User          @relation(fields: [sellerId], references: [id])
  priceOffers  PriceOffer[]

  @@index([createdAt(sort: Desc)])
  @@index([isPremium, createdAt(sort: Desc)])
  @@map("listings_fjb")
}

model PriceOffer {
  id           String           @id @default(cuid())
  listingId    String
  buyerName    String
  buyerPhone   String
  offeredPrice Int
  message      String?
  status       PriceOfferStatus @default(PENDING)
  createdAt    DateTime         @default(now())
  listing      Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, createdAt(sort: Desc)])
  @@map("price_offers")
}

model AdBoost {
  id            String        @id @default(cuid())
  userId        String
  listingId     String
  amount        Int
  duration      Int
  paymentStatus PaymentStatus @default(PENDING)
  midtransToken String?
  midtransUrl   String?
  paidAt        DateTime?
  expiresAt     DateTime?
  createdAt     DateTime      @default(now())
  listing       Listing       @relation(fields: [listingId], references: [id])
  user          User          @relation(fields: [userId], references: [id])

  @@map("ad_boosts")
}

model Event {
  id                   String           @id @default(cuid())
  organizerId          String
  title                String
  description          String
  category             String
  coverImage           String?
  layoutImage          String?
  location             String
  address              String?
  eventDate            DateTime
  registrationDeadline DateTime?
  price                Int              @default(0)
  quota                Int
  registeredCount      Int              @default(0)
  status               EventStatus      @default(DRAFT)
  package              EventPackage     @default(STARTER)
  requiresJersey       Boolean          @default(false)
  requiresBib          Boolean          @default(false)
  customFields         Json?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  feeType              String           @default("FEE_ON_TOP")
  endDate              DateTime?
  facilities           String[]
  lineUp               Json?
  termsAndConditions   String?
  maxPerPerson              Int?
  oneEmailOneTransaction    Boolean          @default(false)
  uniqueParticipants        Boolean          @default(false)
  organizer            User             @relation("OrganizerEvents", fields: [organizerId], references: [id])
  ticketCategories     TicketCategory[]
  tickets              Ticket[]

  @@index([eventDate])
  @@index([status, eventDate])
  @@map("events")
}

model TicketCategory {
  id           String   @id @default(cuid())
  eventId      String
  name         String
  description  String?
  price        Int      @default(0)
  quota        Int      @default(100)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  maxPerPerson  Int      @default(10)
  isPresale     Boolean  @default(false)
  isDiscount    Boolean  @default(false)
  originalPrice Int?
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tickets      Ticket[]

  @@index([eventId])
  @@map("ticket_categories")
}

model Ticket {
  id               String          @id @default(cuid())
  eventId          String
  userId           String?
  ticketCode       String          @unique @default(cuid())
  qrCodeData       String?
  paymentStatus    PaymentStatus   @default(PENDING)
  midtransToken    String?
  midtransOrderId  String?         @unique
  paidAt           DateTime?
  checkedInAt      DateTime?
  participantName  String
  participantPhone String?
  participantEmail String?
  participantKtp   String?
  ordererPhone     String?
  ordererEmail     String?
  jerseySize       String?
  bibNumber        String?
  customData       Json?
  amount           Int
  platformFee      Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  paymentMethod    String?
  qrString         String?
  ticketCategoryId String?
  vaExpiry         DateTime?
  vaNumber         String?
  orderId          String?
  event            Event           @relation(fields: [eventId], references: [id])
  ticketCategory   TicketCategory? @relation(fields: [ticketCategoryId], references: [id])
  user             User?           @relation(fields: [userId], references: [id])
  transfers        TicketTransfer[]

  @@index([eventId])
  @@index([paymentStatus])
  @@map("tickets")
}

model TicketTransfer {
  id          String         @id @default(cuid())
  ticketId    String
  fromUserId  String
  toEmail     String
  toUserId    String?
  status      TransferStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  acceptedAt  DateTime?
  ticket      Ticket         @relation(fields: [ticketId], references: [id])
  fromUser    User           @relation("TransfersSent", fields: [fromUserId], references: [id])
  toUser      User?          @relation("TransfersReceived", fields: [toUserId], references: [id])

  @@index([ticketId])
  @@index([toUserId, status])
  @@map("ticket_transfers")
}

model Umkm {
  id               String       @id @default(cuid())
  ownerId          String
  name             String
  category         String
  description      String
  address          String?
  latitude         Float?
  longitude        Float?
  phone            String?
  instagram        String?
  website          String?
  imageUrl         String?
  isVerified       Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  gallery          String[]
  mapsUrl          String?
  isMarketplace              Boolean           @default(false)
  shippingMethods            String[]
  operatingHours             String?
  replyTime                  String?
  marketplaceStatus          MarketplaceStatus @default(NONE)
  marketplaceRejectedReason  String?
  marketplaceAppliedAt       DateTime?
  shippingConfig             Json           @default("{}")  // ShippingConfig: per-method enabled/fee/freeMinimum
  // Legacy fields (deprecated, gunakan shippingConfig)
  shippingFeeLocal           Int            @default(0)
  shippingFeeOutside         Int            @default(0)
  shippingOutsideEnabled     Boolean        @default(false)
  freeShippingMinimum        Int            @default(0)
  bankName                   String?
  bankAccountNumber          String?
  bankAccountName            String?
  verificationKtpName        String?
  verificationKtpNumber      String?
  verificationKtpImageUrl    String?
  verificationNibNumber      String?
  verificationNibImageUrl    String?
  verificationStorePhotos    String[]
  owner            User         @relation(fields: [ownerId], references: [id])
  reviews          UmkmReview[]
  products         Product[]
  conversations    Conversation[]
  withdrawals      SellerWithdrawal[]

  @@index([category])
  @@map("umkm")
}

model Product {
  id          String          @id @default(cuid())
  umkmId      String
  name        String
  description String
  price       Int
  stock       Int             @default(0)
  images      String[]
  category    String
  weight      Int?            // gram, untuk ongkir
  status      ProductStatus   @default(ACTIVE)
  soldCount   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  umkm        Umkm            @relation(fields: [umkmId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]

  favorites   ProductFavorite[]

  @@index([umkmId])
  @@index([category])
  @@index([status])
  @@map("products")
}

model ProductFavorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("product_favorites")
}

model CheckoutSession {
  id              String      @id @default(cuid())
  buyerId         String
  totalAmount     Int              // Grand total yang dibayar buyer (semua order + fee)
  totalPlatformFee Int        @default(0)
  totalShippingFee Int        @default(0)
  paymentMethod   String?
  xenditId        String?
  xenditRefId     String?     @unique  // CHECKOUT-{timestamp}
  vaNumber        String?
  qrString        String?
  vaExpiry        DateTime?
  paidAt          DateTime?
  status          PaymentStatus @default(PENDING)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  buyer           User        @relation(fields: [buyerId], references: [id])
  orders          MarketplaceOrder[]

  @@index([buyerId])
  @@index([status])
  @@map("checkout_sessions")
}

model MarketplaceOrder {
  id              String      @id @default(cuid())
  invoiceNumber   String?     @unique
  checkoutSessionId String?
  buyerId         String
  sellerId        String
  totalAmount     Int
  platformFee     Int         @default(0)
  shippingFee     Int         @default(0)  // Ongkir yang dibebankan ke buyer
  shippingMethod  String?                  // PICKUP, LOCAL_COURIER, CROSS_DISTRICT, INTER_ISLAND, DIGITAL
  sellerAmount    Int         @default(0)
  paymentStatus   PaymentStatus @default(PENDING)
  orderStatus     OrderStatus @default(WAITING_PAYMENT)
  paymentMethod   String?
  xenditId        String?
  xenditRefId     String?     @unique
  vaNumber        String?
  qrString        String?
  vaExpiry        DateTime?
  paidAt          DateTime?
  shippedAt       DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  shippingAddress String?
  shippingNote    String?
  trackingNumber  String?
  courier         String?
  buyerNote       String?
  adminNote       String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  checkoutSession CheckoutSession? @relation(fields: [checkoutSessionId], references: [id])
  buyer           User        @relation("OrdersBought", fields: [buyerId], references: [id])
  seller          User        @relation("OrdersSold", fields: [sellerId], references: [id])
  items           OrderItem[]

  @@index([buyerId])
  @@index([sellerId])
  @@index([orderStatus])
  @@index([checkoutSessionId])
  @@map("marketplace_orders")
}

model OrderItem {
  id        String           @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Int
  order     MarketplaceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product          @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model UmkmReview {
  id               String    @id @default(cuid())
  umkmId           String
  reviewerId       String
  rating           Int
  comment          String?
  ownerReply       String?
  ownerRepliedAt   DateTime?
  createdAt        DateTime  @default(now())
  reviewer         User      @relation(fields: [reviewerId], references: [id])
  umkm             Umkm      @relation(fields: [umkmId], references: [id], onDelete: Cascade)

  @@unique([umkmId, reviewerId])
  @@index([umkmId])
  @@map("umkm_reviews")
}

model JobListing {
  id          String    @id @default(cuid())
  posterId    String
  title       String
  company     String
  location    String?
  description String
  salary      String?
  type        String
  contact     String
  isActive    Boolean   @default(true)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  poster      User      @relation(fields: [posterId], references: [id])

  @@index([createdAt(sort: Desc)])
  @@map("job_listings")
}

model VerificationRequest {
  id         String             @id @default(cuid())
  userId     String             @unique
  status     VerificationStatus @default(PENDING)
  ktpUrl     String
  selfieUrl  String
  adminNotes String?
  reviewedAt DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  user       User               @relation(fields: [userId], references: [id])

  @@index([status, createdAt(sort: Desc)])
  @@map("verification_requests")
}

model PhoneOtp {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
  @@map("phone_otps")
}

model ModeratorInvitation {
  id          String    @id @default(cuid())
  token       String    @unique @default(cuid())
  phone       String?
  invitedById String
  usedAt      DateTime?
  usedByName  String?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  invitedBy   User      @relation("InvitedBy", fields: [invitedById], references: [id])

  @@index([token])
  @@map("moderator_invitations")
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

enum UserRole {
  ADMIN
  ORGANIZER
  SELLER
  MEMBER
  MODERATOR
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum ListingStatus {
  ACTIVE
  SOLD
  EXPIRED
  DELETED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ONGOING
  COMPLETED
  CANCELLED
}

enum EventPackage {
  STARTER
  PRO
  ELITE
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PriceOfferStatus {
  PENDING
  CONTACTED
  REJECTED
}

enum TransferStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

model Conversation {
  id        String    @id @default(cuid())
  buyerId   String
  sellerId  String
  umkmId    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  buyer     User      @relation("ConvBuyer",  fields: [buyerId],  references: [id])
  seller    User      @relation("ConvSeller", fields: [sellerId], references: [id])
  umkm      Umkm      @relation(fields: [umkmId], references: [id])
  messages  Message[]

  @@unique([buyerId, sellerId, umkmId])
  @@index([buyerId])
  @@index([sellerId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@map("messages")
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DELETED
}

enum OrderStatus {
  WAITING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum MarketplaceStatus {
  NONE
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REJECTED
}

model SellerBalance {
  id               String   @id @default(cuid())
  sellerId         String   @unique
  totalEarnings    Int      @default(0)
  totalWithdrawn   Int      @default(0)
  totalPending     Int      @default(0)
  availableBalance Int      @default(0)
  updatedAt        DateTime @updatedAt
  seller           User     @relation(fields: [sellerId], references: [id])

  @@map("seller_balances")
}

model SellerWithdrawal {
  id                    String           @id @default(cuid())
  sellerId              String
  umkmId                String
  amount                Int
  withdrawalFee         Int              @default(0)
  netAmount             Int              @default(0)
  status                WithdrawalStatus @default(PENDING)
  bankName              String
  bankAccountNumber     String
  bankAccountName       String
  xenditDisbursementId  String?
  xenditExternalId      String?          @unique
  rejectedReason        String?
  processedAt           DateTime?
  completedAt           DateTime?
  failedAt              DateTime?
  adminNote             String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  seller                User             @relation(fields: [sellerId], references: [id])
  umkm                  Umkm             @relation(fields: [umkmId], references: [id])

  @@index([sellerId, status])
  @@index([status, createdAt])
  @@map("seller_withdrawals")
}

model BalanceLedger {
  id          String   @id @default(cuid())
  sellerId    String
  type        String
  amount      Int
  referenceId String?
  note        String?
  createdAt   DateTime @default(now())

  @@index([sellerId, createdAt])
  @@map("balance_ledger")
}
