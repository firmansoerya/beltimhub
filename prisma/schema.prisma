// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MODERATOR
  ORGANIZER
  SELLER
  MEMBER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum ListingStatus {
  ACTIVE
  SOLD
  EXPIRED
  DELETED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ONGOING
  COMPLETED
  CANCELLED
}

enum EventPackage {
  STARTER
  PRO
  ELITE
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id          String    @id @default(cuid())
  clerkId     String    @unique
  fullName    String
  email       String?   @unique
  phoneNumber String?   @unique
  role        UserRole  @default(MEMBER)
  avatarUrl   String?
  isVerified  Boolean   @default(false)
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  listings              Listing[]
  events                Event[]      @relation("OrganizerEvents")
  tickets               Ticket[]
  adBoosts              AdBoost[]
  umkm                  Umkm[]
  jobListings           JobListing[]
  verificationRequest   VerificationRequest?
  sentInvitations       ModeratorInvitation[] @relation("InvitedBy")

  @@map("users")
}

model News {
  id          String   @id @default(cuid())
  title       String
  snippet     String
  imageUrl    String?
  sourceUrl   String   @unique
  sourceName  String
  publishedAt DateTime
  crawledAt   DateTime @default(now())
  isActive    Boolean  @default(true)

  @@index([publishedAt(sort: Desc)])
  @@map("news")
}

model Listing {
  id           String        @id @default(cuid())
  sellerId     String
  title        String
  description  String
  price        Int
  category     String
  images       String[]
  location     String?
  status       ListingStatus @default(ACTIVE)
  isPremium    Boolean       @default(false)
  premiumUntil DateTime?
  viewCount    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  seller User      @relation(fields: [sellerId], references: [id])
  boosts AdBoost[]

  @@index([createdAt(sort: Desc)])
  @@index([isPremium, createdAt(sort: Desc)])
  @@map("listings_fjb")
}

model AdBoost {
  id            String        @id @default(cuid())
  userId        String
  listingId     String
  amount        Int
  duration      Int
  paymentStatus PaymentStatus @default(PENDING)
  midtransToken String?
  midtransUrl   String?
  paidAt        DateTime?
  expiresAt     DateTime?
  createdAt     DateTime      @default(now())

  user    User    @relation(fields: [userId], references: [id])
  listing Listing @relation(fields: [listingId], references: [id])

  @@map("ad_boosts")
}

model Event {
  id                   String       @id @default(cuid())
  organizerId          String
  title                String
  description          String
  category             String
  coverImage           String?
  location             String
  address              String?
  eventDate            DateTime
  registrationDeadline DateTime?
  price                Int          @default(0)
  quota                Int
  registeredCount      Int          @default(0)
  status               EventStatus  @default(DRAFT)
  package              EventPackage @default(STARTER)
  requiresJersey       Boolean      @default(false)
  requiresBib          Boolean      @default(false)
  customFields         Json?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  organizer User     @relation("OrganizerEvents", fields: [organizerId], references: [id])
  tickets   Ticket[]

  @@index([eventDate(sort: Asc)])
  @@index([status, eventDate(sort: Asc)])
  @@map("events")
}

model Ticket {
  id               String        @id @default(cuid())
  eventId          String
  userId           String?
  ticketCode       String        @unique @default(cuid())
  qrCodeData       String?
  paymentStatus    PaymentStatus @default(PENDING)
  midtransToken    String?
  midtransOrderId  String?       @unique
  paidAt           DateTime?
  checkedInAt      DateTime?
  participantName  String
  participantPhone String?
  participantEmail String?
  jerseySize       String?
  bibNumber        String?
  customData       Json?
  amount           Int
  platformFee      Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  event Event  @relation(fields: [eventId], references: [id])
  user  User?  @relation(fields: [userId], references: [id])

  @@index([eventId])
  @@index([paymentStatus])
  @@map("tickets")
}

model Umkm {
  id          String   @id @default(cuid())
  ownerId     String
  name        String
  category    String
  description String
  address     String?
  phone       String?
  instagram   String?
  website     String?
  imageUrl    String?
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id])

  @@index([category])
  @@map("umkm")
}

model JobListing {
  id          String    @id @default(cuid())
  posterId    String
  title       String
  company     String
  location    String?
  description String
  salary      String?
  type        String
  contact     String
  isActive    Boolean   @default(true)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  poster User @relation(fields: [posterId], references: [id])

  @@index([createdAt(sort: Desc)])
  @@map("job_listings")
}

model VerificationRequest {
  id         String             @id @default(cuid())
  userId     String             @unique
  status     VerificationStatus @default(PENDING)
  ktpUrl     String
  selfieUrl  String
  adminNotes String?
  reviewedAt DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([status, createdAt(sort: Desc)])
  @@map("verification_requests")
}

model ModeratorInvitation {
  id          String    @id @default(cuid())
  token       String    @unique @default(cuid())
  phone       String?
  invitedById String
  usedAt      DateTime?
  usedByName  String?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  invitedBy User @relation("InvitedBy", fields: [invitedById], references: [id])

  @@index([token])
  @@map("moderator_invitations")
}
